{
  "uid": "arkore-overview",
  "title": "Arkore overview",
  "description": "Traffic, latency, the Node process and the database, for the whole stack.",
  "tags": ["arkore"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Service",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "arkore-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"arkore-web\"}",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "arkore-prometheus" }
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "down", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "up", "color": "green", "index": 1 } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests per second",
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "arkore-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(arkore_http_request_duration_seconds_count[5m]))",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "arkore-prometheus" }
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Accounts",
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "arkore-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "arkore_users_total",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "arkore-prometheus" }
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Designs",
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "arkore-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (visibility) (arkore_designs_total)",
          "legendFormat": "{{visibility}}",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "arkore-prometheus" }
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Active sessions",
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "arkore-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "arkore_sessions_active",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "arkore-prometheus" }
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Requests per second by route",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "arkore-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(arkore_http_request_duration_seconds_count[5m]))",
          "legendFormat": "{{route}}",
          "datasource": { "type": "prometheus", "uid": "arkore-prometheus" }
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"], "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "95th percentile response time by route",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "arkore-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(arkore_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}",
          "datasource": { "type": "prometheus", "uid": "arkore-prometheus" }
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"], "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Responses by status",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "arkore-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(arkore_http_request_duration_seconds_count[5m]))",
          "legendFormat": "{{status}}",
          "datasource": { "type": "prometheus", "uid": "arkore-prometheus" }
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 20, "stacking": { "mode": "normal" }, "showPoints": "never" }
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Requests in flight",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "arkore-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "arkore_http_requests_in_flight",
          "legendFormat": "in flight",
          "datasource": { "type": "prometheus", "uid": "arkore-prometheus" }
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Event loop lag",
      "description": "How long a task waits before Node can run it. Sustained growth means the single thread is saturated.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "arkore-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "nodejs_eventloop_lag_p99_seconds{job=\"arkore-web\"}",
          "legendFormat": "p99",
          "datasource": { "type": "prometheus", "uid": "arkore-prometheus" }
        },
        {
          "refId": "B",
          "expr": "nodejs_eventloop_lag_mean_seconds{job=\"arkore-web\"}",
          "legendFormat": "mean",
          "datasource": { "type": "prometheus", "uid": "arkore-prometheus" }
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Process CPU and memory",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "arkore-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=\"arkore-web\"}[5m])",
          "legendFormat": "cores used",
          "datasource": { "type": "prometheus", "uid": "arkore-prometheus" }
        },
        {
          "refId": "B",
          "expr": "process_resident_memory_bytes{job=\"arkore-web\"}",
          "legendFormat": "resident memory",
          "datasource": { "type": "prometheus", "uid": "arkore-prometheus" }
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "resident memory" },
            "properties": [
              { "id": "unit", "value": "bytes" },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Design writes per minute",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "arkore-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(arkore_design_writes_total[15m])) * 60",
          "legendFormat": "{{kind}}",
          "datasource": { "type": "prometheus", "uid": "arkore-prometheus" }
        },
        {
          "refId": "B",
          "expr": "sum by (result) (rate(arkore_signins_total[15m])) * 60",
          "legendFormat": "sign-in {{result}}",
          "datasource": { "type": "prometheus", "uid": "arkore-prometheus" }
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      }
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Database connections",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "arkore-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (datname) (pg_stat_database_numbackends{datname!=\"\"})",
          "legendFormat": "{{datname}}",
          "datasource": { "type": "prometheus", "uid": "arkore-prometheus" }
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Database size",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "arkore-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_database_size_bytes{datname!=\"\"}",
          "legendFormat": "{{datname}}",
          "datasource": { "type": "prometheus", "uid": "arkore-prometheus" }
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      }
    }
  ]
}
