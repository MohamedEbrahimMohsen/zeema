{
  "uid": "arkore-overview",
  "title": "Arkore overview",
  "description": "Traffic, availability, latency and the most used designs.",
  "tags": [
    "arkore"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests per second",
      "description": "Average over the selected range. Covers the whole time range selected at the top of the page, so widening the range widens the measurement. Health checks and metric scrapes are excluded.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "arkore-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(arkore_http_request_duration_seconds_count{section!=\"ops\"}[$__range])) / $__range_s",
          "datasource": {
            "type": "prometheus",
            "uid": "arkore-prometheus"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Availability",
      "description": "Share of the selected range in which the server answered Prometheus at all. This is the number that falls when the service is down. Covers the whole time range selected at the top of the page, so widening the range widens the measurement.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "arkore-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time(up{job=\"arkore-web\"}[$__range])",
          "datasource": {
            "type": "prometheus",
            "uid": "arkore-prometheus"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Downtime in range",
      "description": "How long the server was unreachable during the selected range. Measured from the scrapes, so a period when Prometheus itself was down counts as unknown, not as downtime.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 10,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "arkore-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - avg_over_time(up{job=\"arkore-web\"}[$__range])) * $__range_s",
          "datasource": {
            "type": "prometheus",
            "uid": "arkore-prometheus"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Successful requests",
      "description": "Share of answered requests that did not fail with a server error. Blind to downtime on its own, which is why Availability sits next to it. Covers the whole time range selected at the top of the page, so widening the range widens the measurement.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "arkore-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(arkore_http_request_duration_seconds_count{section!=\"ops\",status!~\"5..\"}[$__range])) / sum(increase(arkore_http_request_duration_seconds_count{section!=\"ops\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "arkore-prometheus"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "noValue": "no traffic"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Latency, 95th percentile",
      "description": "Across every request in the selected range. Covers the whole time range selected at the top of the page, so widening the range widens the measurement.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "arkore-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (increase(arkore_http_request_duration_seconds_bucket{section!=\"ops\"}[$__range])))",
          "datasource": {
            "type": "prometheus",
            "uid": "arkore-prometheus"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "no traffic"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Requests per second by section",
      "description": "Canvas, design page, browse, api and the rest, each as its own line.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "arkore-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (section) (rate(arkore_http_request_duration_seconds_count{section!=\"ops\",section!=\"\"}[5m]))",
          "legendFormat": "{{section}}",
          "datasource": {
            "type": "prometheus",
            "uid": "arkore-prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Availability and errors over time",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "arkore-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time(up{job=\"arkore-web\"}[$__rate_interval])",
          "datasource": {
            "type": "prometheus",
            "uid": "arkore-prometheus"
          },
          "legendFormat": "service reachable"
        },
        {
          "refId": "B",
          "expr": "sum(rate(arkore_http_request_duration_seconds_count{section!=\"ops\",status!~\"5..\"}[$__rate_interval])) / sum(rate(arkore_http_request_duration_seconds_count{section!=\"ops\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "arkore-prometheus"
          },
          "legendFormat": "successful request share"
        },
        {
          "refId": "C",
          "expr": "sum by (status) (rate(arkore_http_request_duration_seconds_count{section!=\"ops\",status=~\"[45]..\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "arkore-prometheus"
          },
          "legendFormat": "{{status}} per second"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*per second"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "max",
                "value": null
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Latency, all requests",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "arkore-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(arkore_http_request_duration_seconds_bucket{section!=\"ops\"}[5m])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "arkore-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(arkore_http_request_duration_seconds_bucket{section!=\"ops\"}[5m])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "arkore-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(arkore_http_request_duration_seconds_bucket{section!=\"ops\"}[5m])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "arkore-prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Latency by API endpoint, 95th percentile",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "arkore-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(arkore_http_request_duration_seconds_bucket{section=~\"api|auth|admin-api\"}[5m])))",
          "legendFormat": "{{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "arkore-prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 30,
      "type": "table",
      "title": "Top 50 designs by views",
      "description": "Lifetime totals from the database, not a time window.",
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "arkore-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select d.title as \"Design\", coalesce(u.username, 'arkore') as \"Owner\", d.visibility as \"Visibility\", s.view_count as \"Views\", s.clone_count as \"Clones\" from design_stats s join designs d on d.id = s.design_id left join users u on u.id = d.owner_id where d.deleted_at is null order by s.view_count desc, d.title asc limit 50",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "arkore-postgres"
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": []
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Views"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              },
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Clones"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Visibility"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          }
        ]
      }
    },
