# Leave DATABASE_URL unset to use an embedded Postgres (PGlite) under apps/web/.pglite for local work.
# DATABASE_URL=postgres://user:pass@host:5432/zeema

# GitHub OAuth app (Settings > Developer settings > OAuth Apps). Callback: <origin>/api/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Usernames (comma-separated) granted the admin role at their next sign-in. Only needed to
# bootstrap the first admin; after that, roles are managed from the IAM page.
# ZEEMA_ADMINS=

# Reverse proxies in front of the app that append X-Forwarded-For (0 = ignore the header).
# TRUSTED_PROXY=0

# The app's public origin: the OAuth callback, redirects, the cross-site write check and HSTS.
CANVAS_URL=http://localhost:3100

# Repository root holding kinds/, components/, rules/, designs/ (defaults to the monorepo root).
# ZEEMA_ROOT=
