{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "arkore-canvas",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "editor/serve.mjs",
        "8000"
      ],
      "port": 8000,
      "url": "http://localhost:8000"
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "D:/Personal/_arkore/apps/web",
        "dev"
      ],
      "port": 3100,
      "autoPort": true
    }
  ]
}
