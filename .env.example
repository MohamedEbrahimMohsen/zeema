# Copy to .env before `docker compose up`. Compose reads this file automatically.
# Nothing here belongs in git: .env is ignored.

# ── required ────────────────────────────────────────────────────────────────
# The database password. Any long random string; it never leaves this machine.
POSTGRES_PASSWORD=change-me
# Guards /api/metrics and is handed to Prometheus as its bearer token.
#   generate with:  openssl rand -hex 24
METRICS_TOKEN=change-me
# The Grafana admin password. The user name is `admin` unless GRAFANA_USER is set.
GRAFANA_PASSWORD=change-me
# Password for grafana_ro, the read-only database account Grafana uses for the design tables.
GRAFANA_DB_PASSWORD=change-me
# Salt for the hashed network addresses in the event log. The app refuses to start in
# production on an unset or placeholder salt.   generate with:  openssl rand -hex 24
EVENT_SALT=change-me

# ── tunnel ──────────────────────────────────────────────────────────────────
# docker-compose.deploy.yml only: the Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=

# ── sign-in ─────────────────────────────────────────────────────────────────
# The canvas app's public origin: the OAuth callback (<CANVAS_URL>/api/auth/github/callback),
# redirects, the cross-site write check, HSTS and the landing's "Open Canvas" button.
CANVAS_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Usernames granted the admin role at their next sign-in, comma separated. Only needed once.
ZEEMA_ADMINS=

# ── optional ────────────────────────────────────────────────────────────────
# How many reverse proxies in front of the app append to X-Forwarded-For. 0 (the default for
# this file) ignores the header: right when the app's port is reached directly. Set 1 when one
# TLS proxy (Caddy, nginx, Traefik) forwards to it; docker-compose.deploy.yml defaults to 1.
TRUSTED_PROXY=0
# 0 skips seeding the curated designs into an empty database.
AUTO_SEED=1
POSTGRES_DB=zeema
POSTGRES_USER=zeema
PROMETHEUS_RETENTION=30d

# ── where each service listens on the host ──────────────────────────────────
# Only the app and landing face the network here. docker-compose.deploy.yml defaults WEB_BIND and
# LANDING_BIND to 127.0.0.1 instead: the Cloudflare Tunnel reaches them on the compose network.
# The rest bind to localhost; reach them over an SSH tunnel:
#   ssh -L 3001:127.0.0.1:3001 you@your-server     then open http://localhost:3001
WEB_BIND=0.0.0.0
WEB_PORT=3000
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3001
PROMETHEUS_BIND=127.0.0.1
PROMETHEUS_PORT=9090
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432

# ── landing page (separate port) ────────────────────────────────────────────
# The marketing landing page runs as its own tiny service. Its "Open Canvas" / "Get started"
# buttons send visitors to CANVAS_URL (set above).
LANDING_BIND=0.0.0.0
LANDING_PORT=4000
