{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arkore.dev/schema/v1/rule.schema.json",
  "title": "Arkore Rule",
  "description": "A deterministic lint rule expressed with the fixed v1 predicate set.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "type", "id", "severity", "select", "when", "message"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "type": { "const": "rule" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "severity": { "enum": ["error", "warning", "info"] },
    "select": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "node": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "kind": { "$ref": "#/definitions/idOrList" },
            "category": { "$ref": "#/definitions/idOrList" }
          }
        },
        "edge": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "mode": { "enum": ["sync", "async"] } }
        },
        "design": { "const": true }
      }
    },
    "when": { "$ref": "#/definitions/predicate" },
    "message": { "type": "string", "minLength": 1 }
  },
  "definitions": {
    "idOrList": {
      "oneOf": [
        { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } }
      ]
    },
    "scalar": { "type": ["boolean", "integer", "string"] },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "eq": { "type": "integer" },
        "gt": { "type": "integer" },
        "lt": { "type": "integer" }
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/predicate" } },
        "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/predicate" } },
        "not": { "$ref": "#/definitions/predicate" },
        "prop": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
        "requirement": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*)*$" },
        "equals": { "$ref": "#/definitions/scalar" },
        "in": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/scalar" } },
        "exists": { "type": "boolean" },
        "hasEdge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["direction"],
          "properties": {
            "direction": { "enum": ["in", "out", "any"] },
            "mode": { "enum": ["sync", "async"] },
            "peerKind": { "$ref": "#/definitions/idOrList" }
          }
        },
        "inGroup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["region", "availability-zone", "vpc", "trust-zone", "system"] },
            "count": { "$ref": "#/definitions/comparison" }
          }
        },
        "syncChainDepth": { "$ref": "#/definitions/comparison" }
      }
    }
  }
}
